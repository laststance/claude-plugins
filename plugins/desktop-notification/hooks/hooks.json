{
  "description": "Sends a macOS desktop notification for each Claude Code Notification event",
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/notify.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
